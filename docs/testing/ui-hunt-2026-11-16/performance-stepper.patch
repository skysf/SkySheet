+    /// 仅验证插桩使用：握手发生在计时之外，等待时主线程不做绘图工作。
+    private func stepperEvent(_ state: String, name: String, index: Int, sample: FrameSample? = nil) {
+        var fields: [String: Any] = ["state": state, "name": name, "index": index]
+        if let sample { fields["ms"] = sample.ms }
+        guard let data = try? JSONSerialization.data(withJSONObject: fields) else { exit(1) }
+        var line = Data("SKYSHEET_STEP ".utf8)
+        line.append(data)
+        line.append(10)
+        FileHandle.standardOutput.write(line)
+        if state == "ready" {
+            guard let command = try? FileHandle.standardInput.read(upToCount: 3), command == Data("go\n".utf8) else {
+                FileHandle.standardError.write(Data("benchmark stepper stopped\n".utf8))
+                exit(1)
+            }
+        }
+    }
+
     private func record(_ name: String, _ samples: [FrameSample]) {
         results.append(BenchmarkResult(name: name, frames: samples))
     }
